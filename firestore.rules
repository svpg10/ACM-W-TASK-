rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.playerName is string &&
        data.playerName.size() >= 1 &&
        data.playerName.size() <= 25 &&
        data.score is number &&
        data.score >= 0 &&
        data.score <= 100 &&
        data.totalQuestions is number &&
        data.totalQuestions >= 1 &&
        data.totalQuestions <= 100 &&
        data.categoryMode in ['all', 'acm', 'ai', 'speedrun'] &&
        (!('accuracyPercent' in data) || (data.accuracyPercent is number && data.accuracyPercent >= 0 && data.accuracyPercent <= 100)) &&
        (!('timeTakenSec' in data) || (data.timeTakenSec is number && data.timeTakenSec >= 0 && data.timeTakenSec <= 3600)) &&
        (!('avatarSeed' in data) || (data.avatarSeed is string && data.avatarSeed.size() <= 50)) &&
        (!('rankTitle' in data) || (data.rankTitle is string && data.rankTitle.size() <= 50));
    }

    // Public connection health check
    match /test/{docId} {
      allow get: if true;
    }

    // Global benchmark leaderboard
    match /leaderboard/{entryId} {
      allow get, list: if true;
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow update, delete: if false;
    }
  }
}
